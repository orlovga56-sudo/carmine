{
  "name": "carmine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Carmine — free music streaming with a black & red soul.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "icons": "node scripts/icons.mjs",
    "ico": "node scripts/ico.mjs",
    "desktop": "npm run build && electron .",
    "desktop:dev": "set CARMINE_DEV=1&& electron .",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "com.carmine.player",
    "productName": "Carmine",
    "copyright": "Carmine",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Carmine",
      "artifactName": "Carmine-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Carmine-${version}-portable.${ext}"
    }
  }
}
